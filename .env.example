# Copy to .env for local development. .env is gitignored and must never be
# committed or deployed -- its presence is what tells settings.py that this is
# a local run rather than a server.
DJANGO_DEBUG=1

# Local runs fall back to sqlite when this is unset. A deployed instance must
# set it (Postgres). On a serverless host use the POOLED connection string --
# the one with "-pooler" (Neon) or port 6543 (Supabase). Each request runs in
# its own process, so an unpooled URL exhausts the connection limit fast.
# DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname

# Object storage for product photos, gallery shots and hero videos.
# REQUIRED on Vercel: its filesystem is read-only, so without this every
# dashboard upload raises OSError and existing images 404. Unset locally means
# "use ./media", which is what you want for development.
# Get the value from cloudinary.com -> Dashboard -> API Environment variable.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Generate one for production: python -c "import secrets;print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# Gmail App Password (not the account password). Without it, order emails are
# printed to the console instead of sent.
# EMAIL_HOST_PASSWORD=
